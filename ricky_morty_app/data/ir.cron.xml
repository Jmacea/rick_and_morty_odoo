<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="characters_data_cron" model="ir.cron">
        <field name="name">Characters Data</field>
        <field name="model_id" ref="ricky_morty_app.model_rick_morty_characters"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="state">code</field>
        <field name="code">model.random_characters()</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
