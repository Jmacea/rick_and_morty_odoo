<odoo>
  <data>

    <record id="rick_morty_characters_view_tree" model="ir.ui.view">
      <field name="name">rick.morty.characters.view.tree</field>
      <field name="model">rick.morty.characters</field>
      <field name="arch" type="xml">
        <tree>
          <field name="characters_id"/>
          <field name="characters_name"/>
          <field name="characters_species"/>
          <field name="characters_status" 
            decoration-success="characters_status == 'Alive'"
            decoration-danger="characters_status == 'Dead'" 
            decoration-muted="characters_status == 'unknown'" 
            widget="badge"/>
          <field name="characters_type"/>
          <field name="characters_gender"/>
        </tree>
      </field>
    </record>

    <record id="rick_morty_characters_view_form" model="ir.ui.view">
      <field name="name">rick.morty.characters.view.form</field>
      <field name="model">rick.morty.characters</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <field name="characters_image" widget="image" class="oe_avatar"/>
            <div class="oe_title">
                <h1>
                  <field name="characters_name" />
                </h1>
            </div>
              <group>
                  <group>
                    <field name="characters_species" />
                    <field name="characters_status" />
                    <field name="characters_type" />
                    <field name="characters_gender" />
                  </group>
                  <group >
                    <field name="characters_location" />
                    <field name="characters_origin" />
                  </group>
              </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="rick_morty_characters_view_kanban" model="ir.ui.view">
      <field name="name">rick.morty.characters.view.kanban</field>
      <field name="model">rick.morty.characters</field>
      <field name="arch" type="xml">
        <kanban>
          <field name="id"/>
          <field name="characters_id" />
          <field name="characters_name" />
          <field name="characters_status" />
          <field name="characters_type" />
          <field name="characters_gender" />
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                    <t t-set="background_image" t-value="kanban_image('rick.morty.characters', 'characters_image', record.id.raw_value)"/>
                    <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{background_image}')">
                        <img class="o_kanban_image_inner_pic" t-if="record.id.raw_value" t-att-alt="record.id.value" t-att-src="kanban_image('rick.morty.characters', 'characters_image', record.id.raw_value)"/>
                    </div>
                    <div class="o_kanban_image d-md-none" t-attf-style="background-image: url(#{background_image})">
                        <img class="o_kanban_image_inner_pic" t-if="record.id.raw_value" t-att-alt="record.id.value" t-att-src="kanban_image('rick.morty.characters', 'characters_image', record.id.raw_value)"/>
                    </div>
                <div class="oe_kanban_details d-flex flex-column justify-content-between">
                    <div>
                        <strong class="o_kanban_record_title oe_partner_heading"><field name="characters_name"/></strong>
                        <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                        <ul>
                            <li>Specie: <field name="characters_species"/></li>
                            <li>Type: <field name="characters_type"/></li>
                            <li>Gender: <field name="characters_gender"/></li>
                            <t t-if="record.characters_status.raw_value === 'Alive'">
                              <li class="text-success float-end mb4"><i class="fa fa-circle" role="img" aria-label="Ok" title="Ok"/> Status: <field name="characters_status"/></li>
                            </t>
                            <t t-if="record.characters_status.raw_value === 'Dead'">
                              <li class="text-danger float-end mb4"><i class="fa fa-circle" role="img" aria-label="Invalid" title="Invalid"/> Status: <field name="characters_status"/></li>
                            </t>
                            <t t-if="record.characters_status.raw_value === 'unknown'">
                              <li class="text-secondary float-end mb4" ><i class="fa fa-circle" role="img" aria-label="unknown" title="unknown"/> Status: <field name="characters_status"/></li>
                            </t>
                        </ul>
                    </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <record id="action_rick_morty" model="ir.actions.act_window">
      <field name="name">rick and morty</field>
      <field name="res_model">rick.morty.characters</field>
      <field name="view_mode">tree,form,kanban</field>
    </record>

    <menuitem id="characters" name="Rick and Morty" web_icon="ricky_morty_app,static/description/icon.png" action="action_rick_morty" sequence="0"/>
  </data>
</odoo>